{
  "name": "modern-american-trail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && tsc -p worker && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . && tsc -p worker",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run validate && npm test",
    "worker:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.472.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.148.0"
  }
}
